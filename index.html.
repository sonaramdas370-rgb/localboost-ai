        .fingerprint-icon { font-size: 60px; cursor: pointer; margin: 10px 0; display: inline-block; transition: transform 0.2s; }
        .fingerprint-icon:active { transform: scale(0.9); }
        .bio-status { font-size: 14px; color: #ffd700; margin-top: 8px; font-weight: bold; }
        
        .captcha-box { display: flex; align-items: center; justify-content: center; gap: 10px; background: #12081f; border: 1px solid #4c2885; padding: 14px; border-radius: 10px; margin-bottom: 15px; }
        .captcha-checkbox { width: 22px; height: 22px; accent-color: #ffd700; cursor: pointer; }

        .form-input, .form-textarea { width: 100%; background-color: #12081f; border: 1.5px solid #4c2885; border-radius: 10px; padding: 12px; color: #fff; font-size: 13px; margin-bottom: 12px; }
        .form-input:focus, .form-textarea:focus { border-color: #ffd700; outline: none; }
        .form-textarea { height: 90px; resize: none; }
        
        .submit-btn { width: 100%; background: linear-gradient(135deg, #ffd700, #ffa500); color: #12081f; border: none; padding: 13px; border-radius: 10px; font-weight: 900; cursor: pointer; transition: 0.2s; }
