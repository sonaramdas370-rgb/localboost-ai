        .view-section p { color: #b19cd9; font-size: 13px; margin-bottom: 18px; line-height: 1.4; }
        
        .back-btn { background-color: #24113c; color: #ffd700; border: 1px solid #ffd700; padding: 10px 22px; border-radius: 10px; font-size: 12px; font-weight: bold; cursor: pointer; margin-top: 15px; transition: 0.2s; }
        .back-btn:hover { background-color: #ffd700; color: #12081f; }

        /* 🌟 200% UPGRADED GOLD GRAPH & MODELING */
        .gold-graph-box { background: #12081f; border: 2px solid #ffd700; border-radius: 16px; padding: 20px; margin-bottom: 15px; box-shadow: inset 0 0 20px rgba(255, 215, 0, 0.1); }
        .gold-svg-container { width: 100%; height: 160px; margin-bottom: 15px; }
        .gold-line { fill: none; stroke: url(#goldGrad); stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; animation: glowWave 2s infinite alternate; }
        .gold-area { fill: url(#goldAreaGrad); opacity: 0.4; }
        @keyframes glowWave { 0% { filter: drop-shadow(0 0 3px rgba(255,215,0,0.4)); } 100% { filter: drop-shadow(0 0 12px rgba(255,215,0,0.9)); } }
        
        .days-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 15px; }
        .day-btn { background: #24113c; border: 1px solid #4c2885; color: #f3e8ff; padding: 9px; border-radius: 8px; font-size: 11px; font-weight: bold; cursor: pointer; transition: 0.2s; }
        .day-btn:hover, .day-btn.active { background: #ffd700; color: #12081f; border-color: #ffd700; font-weight: 900; }

        .analytics-summary { background: #24113c; border: 1.5px solid #ffd700; padding: 16px; border-radius: 12px; text-align: left; font-size: 13px; color: #f3e8ff; line-height: 1.6; }

