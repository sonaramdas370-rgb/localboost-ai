        .modules-grid { display: grid; grid-template-columns: 1fr; gap: 15px; margin-bottom: 20px; }
        .module-box { background: linear-gradient(145deg, #24113c, #1a0b2e); border: 1.5px solid #4c2885; border-radius: 18px; padding: 20px; cursor: pointer; transition: all 0.3s ease; }
