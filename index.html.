        .expert-card { background: #12081f; border: 1.5px solid #4c2885; border-radius: 14px; padding: 16px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; text-align: left; cursor: pointer; transition: 0.3s; }
        .expert-card:hover { border-color: #ffd700; background: #24113c; transform: scale(1.02); }
        .expert-left { display: flex; align-items: center; gap: 14px; }
        .expert-avatar { width: 52px; height: 52px; border-radius: 50%; background: #24113c; border: 2px solid #ffd700; display: flex; justify-content: center; align-items: center; font-size: 24px; }
        .expert-info h4 { color: #ffd700; font-size: 15px; margin-bottom: 3px; font-weight: bold; }
        .expert-info p { color: #b19cd9; font-size: 11px; }
        .connect-badge { background: rgba(255, 215, 0, 0.2); color: #ffd700; font-size: 11px; font-weight: bold; padding: 7px 12px; border-radius: 8px; border: 1px solid #ffd700; }

